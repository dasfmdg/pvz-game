// ============================================================================
// 数据库物理结构（pvz-game · Godot 版植物大战僵尸后端）
// 目标数据库：mysql（由 drawDB 兼容 JSON pvz_game.json 转换生成）
// 表数：28  外键数：29
// ============================================================================

// ---- 枚举 ----

Enum audio_kind {
    bgm
    sfx
}

Enum scene_type {
    day
    night
}

// ---- 表 ----

Table players [note: '玩家'] {
    id bigint [pk, increment, not null, note: '主键']
    player_uid varchar(64) [unique, not null, note: '单机玩家标识（工程无登录鉴权，按设备/玩家维度）']
    created_at datetime [not null, default: `current_timestamp()`, note: '创建时间']
    updated_at datetime [not null, default: `current_timestamp()`, note: '更新时间（更新时自动刷新）']
}

Table player_settings [note: '玩家设置'] {
    id bigint [pk, increment, not null, note: '主键']
    player_id bigint [unique, not null, note: '所属玩家（1:1）']
    bgm_volume decimal(4,3) [not null, default: 0.800, note: '背景音乐音量，0.000~1.000（默认 DEFAULT_BGM_VOLUME=0.8）']
    sfx_volume decimal(4,3) [not null, default: 1.000, note: '音效音量，0.000~1.000（默认 DEFAULT_SFX_VOLUME=1.0）']
    muted tinyint [not null, default: false, note: '是否静音（默认 DEFAULT_MUTED=false）']
    updated_at datetime [not null, default: `current_timestamp()`, note: '更新时间']
}

Table player_progress [note: '玩家总进度'] {
    id bigint [pk, increment, not null, note: '主键']
    player_id bigint [unique, not null, note: '所属玩家（1:1）']
    unlocked_level int [not null, default: 0, note: '已解锁到的最大关卡下标（0 基，0~39）']
    updated_at datetime [not null, default: `current_timestamp()`, note: '更新时间']
}

Table player_level_progress [note: '玩家分关进度'] {
    id bigint [pk, increment, not null, note: '主键']
    player_id bigint [not null, note: '所属玩家']
    level_index int [not null, note: '关卡下标（0 基，外键 → levels.id）']
    cleared tinyint [not null, default: false, note: '是否已通关']
    best_kills int [not null, default: 0, note: '该关历史最佳击杀数']
    updated_at datetime [not null, default: `current_timestamp()`, note: '更新时间']

    indexes {
        (player_id, level_index) [unique, name: 'uk_player_level']
    }
}

Table level_clear_events [note: '通关事件流水（运营指标数据源）'] {
    id bigint [pk, increment, not null, note: '主键']
    player_id bigint [not null, note: '所属玩家']
    level_index int [not null, note: '关卡下标（0 基，外键 → levels.id）']
    kills int [not null, default: 0, note: '本局击杀数（clearLevel 上报值）']
    reported_at datetime [not null, default: `current_timestamp()`, note: '上报时间']

    indexes {
        (player_id, reported_at) [name: 'idx_player_time']
        (level_index, reported_at) [name: 'idx_level_time']
    }
}

Table run_saves [note: '单局存档（快照）'] {
    id bigint [pk, increment, not null, note: '主键']
    player_id bigint [not null, note: '所属玩家']
    slot tinyint [not null, note: '存档槽位，1~3（RUN_SLOT_MIN~RUN_SLOT_MAX）']
    snapshot_version int [not null, default: 1, note: '快照结构版本，恒为 1（SNAPSHOT_VERSION），否则拒绝保存']
    level_index int [not null, note: '所在关卡下标（0 基，外键 → levels.id）']
    level_name varchar(64) [not null, note: '关卡显示名（冗余，供存档列表直接展示）']
    time decimal(8,3) [not null, default: 0.000, note: '对局已进行时间（秒）']
    sun int [not null, default: 0, note: '当前阳光']
    killed int [not null, default: 0, note: '当前击杀数']
    sky_sun_timer decimal(8,3) [not null, default: 0.000, note: '天降阳光计时器剩余（秒）']
    saved_at datetime [not null, note: '保存时间（契约的 ISO 8601 → datetime）']
    created_at datetime [not null, default: `current_timestamp()`, note: '创建时间']
    updated_at datetime [not null, default: `current_timestamp()`, note: '更新时间']

    indexes {
        (player_id, slot) [unique, name: 'uk_player_slot']
    }
}

Table run_save_cards [note: '存档·携带卡片植物'] {
    id bigint [pk, increment, not null, note: '主键']
    save_id bigint [not null, note: '所属存档']
    seq int [not null, note: '卡槽顺序（0 基）']
    plant_id varchar(32) [not null, note: '植物 id（外键 → plants.id）']

    indexes {
        (save_id, seq) [unique, name: 'uk_save_card_seq']
    }
}

Table run_save_card_cooldowns [note: '存档·卡片冷却'] {
    id bigint [pk, increment, not null, note: '主键']
    save_id bigint [not null, note: '所属存档']
    plant_id varchar(32) [not null, note: '植物 id（外键 → plants.id）']
    cooldown_seconds decimal(8,3) [not null, default: 0.000, note: '该卡剩余冷却（秒）']

    indexes {
        (save_id, plant_id) [unique, name: 'uk_save_cd_plant']
    }
}

Table run_save_wave_states [note: '存档·波次状态'] {
    id bigint [pk, increment, not null, note: '主键']
    save_id bigint [unique, not null, note: '所属存档（1:1）']
    wave_index int [not null, default: 0, note: '当前波次下标']
    early_trigger_at decimal(8,3) [not null, default: -1.000, note: '提前触发时刻；-1 表示未触发提前等待']
    lane_cursor int [not null, default: 0, note: '上一只僵尸落位行（0~4）']
}

Table run_save_pending_spawns [note: '存档·待出场僵尸'] {
    id bigint [pk, increment, not null, note: '主键']
    wave_state_id bigint [not null, note: '所属波次状态']
    seq int [not null, note: '队列顺序（0 基）']
    dt decimal(8,3) [not null, note: '相对当前时刻的剩余秒数']
    zombie_id varchar(32) [not null, note: '僵尸类型 id（外键 → zombies.id）']

    indexes {
        (wave_state_id, seq) [unique, name: 'uk_pending_seq']
    }
}

Table run_save_plants [note: '存档·场上植物'] {
    id bigint [pk, increment, not null, note: '主键']
    save_id bigint [not null, note: '所属存档']
    seq int [not null, note: '阵型顺序（0 基）']
    plant_id varchar(32) [not null, note: '植物 id（外键 → plants.id）']
    col tinyint [not null, note: '列（0~8，网格 COLS=9）']
    row tinyint [not null, note: '行（0~4，网格 ROWS=5）']
    hp int [not null, default: 0, note: '当前生命']
    state json [note: '植物私有状态（结构随植物类型而变，对应 snapshot_state()）']

    indexes {
        (save_id, seq) [unique, name: 'uk_save_plant_seq']
    }
}

Table run_save_zombies [note: '存档·场上僵尸'] {
    id bigint [pk, increment, not null, note: '主键']
    save_id bigint [not null, note: '所属存档']
    seq int [not null, note: '出场顺序（0 基）']
    zombie_id varchar(32) [not null, note: '僵尸类型 id（外键 → zombies.id）']
    row tinyint [not null, note: '所在行（0~4）']
    x decimal(10,3) [not null, default: 0.000, note: '世界坐标 x']
    hp int [not null, default: 0, note: '当前生命']
    has_hat tinyint [not null, default: false, note: '是否仍持有顶具']
    hat_hp int [not null, default: 0, note: '顶具剩余生命']
    state tinyint [not null, default: 0, note: '状态机：0=Walk，1=Eat（瞬态不入档）']
    slow_t decimal(8,3) [not null, default: 0.000, note: '剩余减速时长（秒）']
    bite_t decimal(8,3) [not null, default: 0.000, note: '下次啃食倒计时（秒）']

    indexes {
        (save_id, seq) [unique, name: 'uk_save_zombie_seq']
    }
}

Table run_save_mowers [note: '存档·割草机'] {
    id bigint [pk, increment, not null, note: '主键']
    save_id bigint [not null, note: '所属存档']
    row tinyint [not null, note: '所在行（0~4，每行一个）']
    used tinyint [not null, default: false, note: '是否已使用']
    running tinyint [not null, default: false, note: '是否正在冲出']
    x decimal(10,3) [not null, default: 0.000, note: '世界坐标 x']

    indexes {
        (save_id, row) [unique, name: 'uk_save_mower_row']
    }
}

Table levels [note: '关卡'] {
    id int [pk, not null, note: '关卡下标（0 基，0~39，与 GameConfig.LEVELS[i].id 对齐）']
    name varchar(64) [not null, note: '关卡显示名（如「第1关 · 初次防守」）']
    difficulty tinyint [not null, note: '难度（1~10）']
    start_sun int [not null, default: 0, note: '初始阳光']
    scene scene_type [not null, default: 'day', note: '场景：day / night（缺省 day）']
    created_at datetime [not null, default: `current_timestamp()`, note: '创建时间']
    updated_at datetime [not null, default: `current_timestamp()`, note: '更新时间']
}

Table level_waves [note: '关卡波次'] {
    id bigint [pk, increment, not null, note: '主键']
    level_id int [not null, note: '关卡（外键 → levels.id）']
    wave_index int [not null, note: '波次序号（0 基）']
    t decimal(8,3) [not null, note: '波次开始时间（秒）']
    huge tinyint [not null, default: false, note: '是否大波（自动追加旗帜僵尸与横幅）']

    indexes {
        (level_id, wave_index) [unique, name: 'uk_level_wave']
    }
}

Table level_wave_zombies [note: '波次僵尸明细'] {
    id bigint [pk, increment, not null, note: '主键']
    wave_id bigint [not null, note: '所属波次']
    seq int [not null, note: '波内顺序（0 基）']
    zombie_id varchar(32) [not null, note: '僵尸类型 id（外键 → zombies.id）']

    indexes {
        (wave_id, seq) [unique, name: 'uk_wave_zombie_seq']
    }
}

Table plants [note: '植物图鉴'] {
    id varchar(32) [pk, not null, note: '植物 id（PLANT_ORDER 顺序，如 sunflower）']
    name varchar(64) [not null, note: '显示名（工程内为英文名，如 Sunflower）']
    cost int [not null, default: 0, note: '阳光价格']
    hp int [not null, default: 300, note: '生命']
    recharge decimal(8,3) [not null, default: 0.000, note: '卡片冷却（秒）']
    unlock_level int [not null, default: 0, note: '0=开局即拥有；否则为对应关序号（1 基）通关后解锁']
    card_order int [not null, note: '卡槽展示顺序（PLANT_ORDER 下标）']
    created_at datetime [not null, default: `current_timestamp()`, note: '创建时间']
    updated_at datetime [not null, default: `current_timestamp()`, note: '更新时间']
}

Table plant_behaviors [note: '植物行为参数'] {
    id bigint [pk, increment, not null, note: '主键']
    plant_id varchar(32) [unique, not null, note: '植物 id（1:1，外键 → plants.id）']
    params json [not null, note: '行为参数（键随植物而异：fire_interval / damage / fuse / arm_time / splash_damage 等）']
    updated_at datetime [not null, default: `current_timestamp()`, note: '更新时间']
}

Table zombies [note: '僵尸图鉴'] {
    id varchar(32) [pk, not null, note: '僵尸类型 id（ZOMBIES 的键，如 basic）']
    name varchar(64) [not null, note: '显示名（工程内为英文名）']
    hp int [not null, note: '总生命']
    speed decimal(8,3) [not null, note: '移动速度（像素/秒）']
    zw decimal(8,3) [not null, note: '绘制宽度']
    zh decimal(8,3) [not null, note: '绘制高度']
    walk varchar(64) [not null, note: '行走动画精灵表名（外键 → sprite_sheets.name）']
    attack varchar(64) [not null, note: '啃食动画精灵表名（外键 → sprite_sheets.name）']
    dirty_walk varchar(64) [note: '损毁态行走精灵表名（逻辑引用 sprite_sheets.name）']
    dirty_attack varchar(64) [note: '损毁态啃食精灵表名（逻辑引用 sprite_sheets.name）']
    dirt_ratio decimal(6,4) [note: '切换损毁外观的生命比例阈值（0~1）']
    hat_hp int [note: '顶具（护甲段）独立生命，仅带顶具僵尸存在']
    hat_ratio decimal(6,4) [note: '顶具外观切换比例，仅带顶具僵尸存在']
    hat_removed_speed decimal(8,3) [note: '顶具被打掉后的速度，仅部分僵尸存在']
    hat_removed_walk varchar(64) [note: '顶具被打掉后的行走精灵表名']
    hat_removed_attack varchar(64) [note: '顶具被打掉后的啃食精灵表名']
    has_flag tinyint [note: '是否持旗（仅 flag 僵尸）']
    jump varchar(64) [note: '翻越动画精灵表名（仅 pole 僵尸）']
    after_jump_walk varchar(64) [note: '翻越落地后行走精灵表名（仅 pole 僵尸）']
    rip varchar(64) [note: '报纸撕碎动画精灵表名（仅 newspaper 僵尸）']
    updated_at datetime [not null, default: `current_timestamp()`, note: '更新时间']
}

Table audio_tracks [note: '音频资源'] {
    id bigint [pk, increment, not null, note: '主键']
    name varchar(64) [unique, not null, note: '音效名 / BGM 名（SOUNDS 的键；BGM 名为 background）']
    kind audio_kind [not null, note: '类别：bgm / sfx']
    path varchar(255) [not null, note: 'res:// 资源路径']
    updated_at datetime [not null, default: `current_timestamp()`, note: '更新时间']
}

Table audio_config [note: '音频播放配置（单例）'] {
    id tinyint [pk, not null, note: '固定为 1（单例约束）']
    pool_size int [not null, default: 8, note: '音效播放器对象池大小（POOL_SIZE）']
    sfx_volume_db decimal(6,2) [not null, default: -6.00, note: '音效基础增益（分贝，SFX_VOLUME_DB）']
    bgm_volume_db decimal(6,2) [not null, default: -16.00, note: 'BGM 基础增益（分贝，BGM_VOLUME_DB）']
    updated_at datetime [not null, default: `current_timestamp()`, note: '更新时间']
}

Table sprite_sheets [note: '精灵表'] {
    name varchar(64) [pk, not null, note: '精灵表名（SHEETS 的键）']
    w int [not null, note: '单帧宽（像素）']
    h int [not null, note: '单帧高（像素）']
    frames int [not null, note: '帧数']
    d decimal(6,4) [note: '统一帧时长（秒）；仅当未单独维护 delays 时存在']
    src varchar(255) [not null, note: 'res:// 资源路径']
    updated_at datetime [not null, default: `current_timestamp()`, note: '更新时间']
}

Table sprite_frame_delays [note: '精灵表逐帧时长'] {
    id bigint [pk, increment, not null, note: '主键']
    sheet_name varchar(64) [not null, note: '精灵表名（外键 → sprite_sheets.name）']
    frame_index int [not null, note: '帧下标（0 基）']
    delay_seconds decimal(6,4) [not null, note: '该帧时长（秒）']

    indexes {
        (sheet_name, frame_index) [unique, name: 'uk_sheet_frame']
    }
}

Table static_textures [note: '静态贴图'] {
    id bigint [pk, increment, not null, note: '主键']
    name varchar(64) [unique, not null, note: '素材名（STATIC_TEXTURES 的键）']
    path varchar(255) [not null, note: 'res:// 资源路径']
    updated_at datetime [not null, default: `current_timestamp()`, note: '更新时间']
}

Table card_textures [note: '卡片贴图'] {
    id bigint [pk, increment, not null, note: '主键']
    plant_id varchar(32) [unique, not null, note: '植物 id（1:1，外键 → plants.id）']
    path varchar(255) [not null, note: 'res:// 资源路径']
    updated_at datetime [not null, default: `current_timestamp()`, note: '更新时间']
}

Table card_regions [note: '卡片切图区域'] {
    id bigint [pk, increment, not null, note: '主键']
    plant_id varchar(32) [unique, not null, note: '植物 id（1:1，外键 → plants.id）']
    x decimal(8,2) [not null, default: 0.00, note: '切图起点 x']
    y decimal(8,2) [not null, default: 0.00, note: '切图起点 y']
    w decimal(8,2) [not null, note: '切图宽']
    h decimal(8,2) [not null, note: '切图高']
    updated_at datetime [not null, default: `current_timestamp()`, note: '更新时间']
}

Table game_rules [note: '全局规则常量（单例）'] {
    id tinyint [pk, not null, note: '固定为 1（单例约束）']
    total_levels int [not null, default: 40, note: '关卡总数（30 主关 + 10 后日谈）']
    run_slot_min tinyint [not null, default: 1, note: '存档槽位下限（RUN_SLOT_MIN）']
    run_slot_max tinyint [not null, default: 3, note: '存档槽位上限（RUN_SLOT_MAX）']
    snapshot_version int [not null, default: 1, note: '当前快照结构版本（SNAPSHOT_VERSION）']
    grid_cols tinyint [not null, default: 9, note: '网格列数（COLS）']
    grid_rows tinyint [not null, default: 5, note: '网格行数（ROWS）']
    wave_unit_gap decimal(6,3) [not null, default: 0.900, note: '同波内单僵尸间隔（秒，WAVE_UNIT_GAP）']
    zombie_bite_interval decimal(6,3) [not null, default: 0.500, note: '啃食间隔（秒，ZOMBIE_BITE_INTERVAL）']
    zombie_bite_damage int [not null, default: 34, note: '每口啃食伤害（ZOMBIE_BITE_DAMAGE）']
    slow_factor decimal(6,4) [not null, default: 0.5000, note: '寒冰减速倍率（SLOW_FACTOR）']
    slow_duration decimal(6,3) [not null, default: 5.000, note: '减速持续时长（秒，SLOW_DURATION）']
    seed_slot_base tinyint [not null, default: 5, note: '卡槽基础数（SEED_SLOT_BASE）']
    seed_slot_step tinyint [not null, default: 4, note: '卡槽每增长步长（SEED_SLOT_STEP）']
    seed_slot_max tinyint [not null, default: 10, note: '卡槽上限（SEED_SLOT_MAX）']
    seed_select_from_level int [not null, default: 7, note: '从此关序号（1 基）起需先选卡（SEED_SELECT_FROM_LEVEL）']
    updated_at datetime [not null, default: `current_timestamp()`, note: '更新时间']
}

Table error_codes [note: '业务错误码字典'] {
    code int [pk, not null, note: '业务错误码（契约 ErrorCode 取值）']
    http_status int [not null, note: '对应 HTTP 状态码']
    default_msg varchar(128) [not null, note: '默认提示信息']
    description varchar(255) [note: '错误说明']
    updated_at datetime [not null, default: `current_timestamp()`, note: '更新时间']
}

// ---- 外键关系（A > B = 多对一；A - B = 一对一；A < B = 一对多）----

Ref: player_settings.player_id - players.id [delete: cascade]
Ref: player_progress.player_id - players.id [delete: cascade]
Ref: player_level_progress.player_id > players.id [delete: cascade]
Ref: player_level_progress.level_index > levels.id
Ref: level_clear_events.player_id > players.id [delete: cascade]
Ref: level_clear_events.level_index > levels.id
Ref: run_saves.player_id > players.id [delete: cascade]
Ref: run_saves.level_index > levels.id
Ref: run_save_cards.save_id > run_saves.id [delete: cascade]
Ref: run_save_cards.plant_id > plants.id
Ref: run_save_card_cooldowns.save_id > run_saves.id [delete: cascade]
Ref: run_save_card_cooldowns.plant_id > plants.id
Ref: run_save_wave_states.save_id - run_saves.id [delete: cascade]
Ref: run_save_pending_spawns.wave_state_id > run_save_wave_states.id [delete: cascade]
Ref: run_save_pending_spawns.zombie_id > zombies.id
Ref: run_save_plants.save_id > run_saves.id [delete: cascade]
Ref: run_save_plants.plant_id > plants.id
Ref: run_save_zombies.save_id > run_saves.id [delete: cascade]
Ref: run_save_zombies.zombie_id > zombies.id
Ref: run_save_mowers.save_id > run_saves.id [delete: cascade]
Ref: level_waves.level_id > levels.id [delete: cascade]
Ref: level_wave_zombies.wave_id > level_waves.id [delete: cascade]
Ref: level_wave_zombies.zombie_id > zombies.id
Ref: plant_behaviors.plant_id - plants.id [delete: cascade]
Ref: card_textures.plant_id - plants.id [delete: cascade]
Ref: card_regions.plant_id - plants.id [delete: cascade]
Ref: sprite_frame_delays.sheet_name > sprite_sheets.name [delete: cascade]
Ref: zombies.walk > sprite_sheets.name
Ref: zombies.attack > sprite_sheets.name
